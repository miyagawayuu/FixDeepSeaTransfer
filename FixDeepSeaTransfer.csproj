<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Version>0.2.0</Version>
    <AssemblyName>FixDeepSeaTransfer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <ModLoader Condition="'$(ModLoader)' == ''">Carbon</ModLoader>
    <DefineConstants Condition="'$(ModLoader)' == 'Carbon'">$(DefineConstants);CARBON</DefineConstants>
    <DefineConstants Condition="'$(ModLoader)' == 'Oxide'">$(DefineConstants);OXIDE</DefineConstants>
    <RustDir Condition="'$(RustDir)' == ''">$(RUSTDIR)</RustDir>
    <ManagedDir>$(RustDir)\RustDedicated_Data\Managed</ManagedDir>
    <CarbonManagedDir>$(RustDir)\carbon\managed</CarbonManagedDir>
    <OxideManagedDir Condition="'$(OxideManagedDir)' == ''">$(ManagedDir)</OxideManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\FixDeepSeaTransfer\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rust.Harmony">
      <HintPath>$(ManagedDir)\Rust.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rust.Data">
      <HintPath>$(ManagedDir)\Rust.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(ManagedDir)\Facepunch.System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(ManagedDir)\Facepunch.Console.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(ManagedDir)\Facepunch.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(ManagedDir)\Facepunch.UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon" Condition="'$(ModLoader)' == 'Carbon'">
      <HintPath>$(CarbonManagedDir)\Carbon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon.Common" Condition="'$(ModLoader)' == 'Carbon'">
      <HintPath>$(CarbonManagedDir)\Carbon.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon.Compat" Condition="'$(ModLoader)' == 'Carbon'">
      <HintPath>$(CarbonManagedDir)\Carbon.Compat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon.SDK" Condition="'$(ModLoader)' == 'Carbon'">
      <HintPath>$(CarbonManagedDir)\Carbon.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Oxide.Common" Condition="'$(ModLoader)' == 'Oxide'">
      <HintPath>$(OxideManagedDir)\Oxide.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Oxide.Core" Condition="'$(ModLoader)' == 'Oxide'">
      <HintPath>$(OxideManagedDir)\Oxide.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Oxide.CSharp" Condition="'$(ModLoader)' == 'Oxide'">
      <HintPath>$(OxideManagedDir)\Oxide.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Oxide.Rust" Condition="'$(ModLoader)' == 'Oxide'">
      <HintPath>$(OxideManagedDir)\Oxide.Rust.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Oxide.Unity" Condition="'$(ModLoader)' == 'Oxide'">
      <HintPath>$(OxideManagedDir)\Oxide.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRustDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RustDir)' == ''">
    <Error Text="Specify RustDir. Example: dotnet build -p:RustDir=C:\path\to\rustserver" />
  </Target>

  <Target Name="ValidateRustReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RustDir)' != ''">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Rust server assemblies were not found under $(ManagedDir). Install or update Rust Dedicated Server first." />
    <Error Condition="'$(ModLoader)' == 'Carbon' and !Exists('$(CarbonManagedDir)\Carbon.dll')" Text="Carbon assemblies were not found under $(CarbonManagedDir). Install Carbon into the Rust server directory first." />
    <Error Condition="'$(ModLoader)' == 'Oxide' and !Exists('$(OxideManagedDir)\Oxide.Rust.dll')" Text="Oxide assemblies were not found under $(OxideManagedDir). Install Oxide into the Rust server directory first." />
    <Error Condition="'$(ModLoader)' != 'Carbon' and '$(ModLoader)' != 'Oxide'" Text="ModLoader must be either Carbon or Oxide." />
  </Target>
</Project>
